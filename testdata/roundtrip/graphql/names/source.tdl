// Names GraphQL keeps, and ones it reads back differently.
package shop.v1

type order_line {
  sku: string
  qty: int32
}

enum Level {
  HTTPError
  Low
}

enum Payment {
  Card { last4: string }
  ACHTransfer { routing: string }
  Cash
}

type Account {
  email: string
  id: string
}

type Ledger {
  payments: [Payment]
  levels: [Level]
}

target graphql for shop.v1 {
  Account => name("User")
  Account.email => name("email_address")
  Level.Low => name("LOWEST")
  Payment.Card => name("CardPayment")
  Payment.Cash => name("PaymentCash")
}
