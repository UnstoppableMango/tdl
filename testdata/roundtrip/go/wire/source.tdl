// Variants whose wire values a wire directive renames, which read back
// as their names without the source annotation, and a field whose JSON
// key it renames, which reads back with it.
package shop

enum Status {
  Live
  Expired
}

enum Payment {
  Card { last4: string }
  Cash
}

type Order {
  status: Status
  payment: Payment
}

target go for shop {
  json
  Status.Live => wire("live")
  Payment.Card => wire("card")
  Order.status => wire("order_status")
}
