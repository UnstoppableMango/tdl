// Variants whose wire values a wire directive renames, which read back
// as their names without the source annotation.
package shop

enum Status {
  Live
  Expired
}

enum Payment {
  Card { last4: string }
  Cash
}

type Order {
  status: Status
  payment: Payment
}

target typescript for shop {
  Status.Live => wire("live")
  Payment.Card => wire("card")
}
