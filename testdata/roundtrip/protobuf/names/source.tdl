// Names and numbers protobuf keeps, and ones it reads back differently.
package shop

type order_line {
  HTTPStatus: int32
  sku: string
  qty: int32
}

enum Level {
  HTTPError
  Low
}

type Account {
  email: string
  id: string
}

target protobuf for shop {
  Account => name("User")
  Account.email => name("email_address")
  Account.id => number(1)
  order_line.qty => number(9)
  Level.Low => name("LEVEL_LOWEST")
}
