package shop.orders

import "common.tdl" as common

type Order: Entity {
  id: OrderId
  customer: User
  shipping: common.Address?
  items: [LineItem] owned
  status: Status = Draft
}

type LineItem: Entity {
  order: Order
  sku: string
  quantity: int
}

type User: Entity {
  id: string
}

type OrderId: string
enum Status { Draft Placed Shipped }
