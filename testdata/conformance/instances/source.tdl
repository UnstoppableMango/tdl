package example.instances

import "shipping.tdl" as shipping

class Auditable {
  createdAt: instant
}

class Paged {
  type Cursor
  pageSize: int
}

instance Auditable<shipping.Address>
instance Auditable for shipping.Address

instance Paged for OrderList {
  type Cursor = OrderCursor
}

instance <T> Auditable<Page<T>> requires Auditable<T>
type OrderList { }

type OrderCursor {
  token: string
}

type Page<T> {
  items: [T]
}

type Audited: Auditable {
  createdAt: instant
}

type Plain {
  x: string
}

type Uses {
  applies: Page<Audited>
  doesNot: Page<Plain>
}
