package example.instances

import "shipping.tdl" as shipping

class Auditable {
  createdAt: instant
}

class Paged {
  type Cursor
  pageSize: int
}

/// Declares no fields, so a conditional instance can satisfy it.
class Archived { }

instance Auditable<shipping.Address>
instance Auditable for shipping.Address

instance Paged for OrderList {
  type Cursor = OrderCursor
}

instance <T> Archived<Page<T>> requires Archived<T>

type OrderList {
  pageSize: int
}

type OrderCursor {
  token: string
}

type Page<T> {
  items: [T]
}

type Audited: Auditable, Archived {
  createdAt: instant
}

type Plain {
  x: string
}

type Uses {
  applies: Page<Audited>
  doesNot: Page<Plain>
}
