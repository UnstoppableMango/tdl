package example.mixins

class Auditable {
  createdAt: instant
  updatedAt: instant
}

mixin Timestamps {
  createdAt: instant
  updatedAt: instant
}

mixin Named {
  name: string
}

type User: Entity, Auditable {
  id: string
  include Timestamps
  include Named
  email: string
}

type Snapshot {
  include Timestamps
}
