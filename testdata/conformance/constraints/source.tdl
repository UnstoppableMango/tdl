package example.constraints

type Email: string where {
  matches /^[^@]+@[^@]+$/
  length 3..254
}

type Slug: string where {
  matches /^[a-z-]+$/
  length 16
}

entity Order {
  key id: string
  quantity: int where { min 1 max 100 }
  items: [string] where { length 1.. unique }
  region: string where { oneOf ["us-east", "eu-west"] }
}
