/* The notation grammar.ebnf is written in, described in itself.

   It is Wirth syntax notation, the dialect the Go and Oberon reports use,
   not ISO 14977: a production ends with '.' rather than ';', and items in
   a sequence are juxtaposed rather than separated by ','.

   A name beginning with an upper-case letter is a nonterminal, defined by
   a production in the same file.  A name beginning with a lower-case
   letter is a terminal the lexer produces and the grammar does not
   define; lex/table.go says what each one accepts.

   Comments follow Go's rules, because golang.org/x/exp/ebnf parses this
   notation, and may appear wherever whitespace may. */

Grammar    = { Production } .
Production = nonterminal "=" Expression "." .

Expression = Sequence { "|" Sequence } .
Sequence   = Term { Term } .
Term       = nonterminal | terminal | quoted | Group | Option | Repetition .

Group      = "(" Expression ")" .
Option     = "[" Expression "]" .
Repetition = "{" Expression "}" .

/* nonterminal is a name beginning with an upper-case letter, terminal a
   name beginning with a lower-case one, and quoted a double-quoted
   literal naming the exact source text of one token.

   An Option matches its contents once or not at all, and a Repetition
   zero or more times.  There are no separator rules: `A { "," A }`
   requires the commas, and nothing is implied between the items of a
   Sequence. */

nonterminal = .
terminal    = .
quoted      = .
