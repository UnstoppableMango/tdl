(* TDL grammar, EBNF appendix to spec.md.
   Notation: '...' terminals, [ ] optional, { } zero-or-more, | alternation. *)

File     = { Decl } .
Decl     = PackageDecl | ImportDecl | PrimitiveDecl | UnitDecl
         | TypeDecl | ValueDecl | EntityDecl | EnumDecl | TargetDecl .

PackageDecl = "package" DottedIdent .
ImportDecl  = "import" string_lit "as" ( identifier | "_" ) .
DottedIdent = identifier { "." identifier } .

(* ---- roots and units ---------------------------------------------------- *)

PrimitiveDecl = "primitive" identifier .

UnitDecl = "unit" identifier [ "=" UnitExpr ] .
UnitExpr = UnitTerm { ( "*" | "/" ) UnitTerm } .
UnitTerm = identifier [ "^" int_lit ] | "(" UnitExpr ")" .

(* ---- declarations ------------------------------------------------------- *)

TypeDecl   = "type" identifier [ TypeParams ] ":" TypeRef [ ConstraintBlock ] .
ValueDecl  = "value" identifier [ TypeParams ] "{" { Field } "}" .
EntityDecl = "entity" identifier [ TypeParams ] "{" { Field } "}" .
EnumDecl   = "enum" identifier [ TypeParams ] "{" { Variant } "}" .

Variant    = identifier [ "{" [ Field { "," Field } ] "}" ] .
TypeParams = "<" identifier { "," identifier } ">" .

Field    = { FieldMod } identifier ":" TypeRef { FieldRel }
           [ ConstraintBlock ] [ "=" Literal ] .
FieldMod = "key" .
FieldRel = "owned" .

(* ---- type references ---------------------------------------------------- *)

TypeRef   = CoreType [ "?" ] [ "|" "null" ] .
CoreType  = ListType | SetOrMapType | NamedType .
ListType  = "[" TypeRef "]" .
SetOrMapType = "{" TypeRef [ "->" TypeRef ] "}" .
NamedType = DottedIdent [ TypeArgs ] .

TypeArgs = "<" TypeArg { "," TypeArg } ">" .
TypeArg  = UnitExpr | TypeRef .
(* TypeArg is ambiguous by design: a bare identifier may name a type or a
   unit.  The parser records the syntactic form; the resolver decides which
   kind each argument is, against the declaration being applied. *)

(* ---- constraints -------------------------------------------------------- *)

ConstraintBlock = "{" [ Constraint { [ "," ] Constraint } ] "}" .
Constraint = "min" Literal
           | "max" Literal
           | "length" Range
           | "matches" regex_lit
           | "oneOf" ListLiteral
           | "unique" .
Range = [ int_lit ] ".." [ int_lit ] | int_lit .

(* ---- targets ------------------------------------------------------------ *)

TargetDecl  = "target" identifier "for" DottedIdent "{" { TargetEntry } "}" .
TargetEntry = Path "{" { TargetEntry } "}"
            | Path "=>" Directive
            | Directive .
Directive   = identifier { DirectiveArg } .
DirectiveArg = Literal | Path .
Path        = identifier { "." identifier } .

(* ---- literals ----------------------------------------------------------- *)

Literal     = string_lit | int_lit | float_lit | bool_lit | ListLiteral .
ListLiteral = "[" [ Literal { "," Literal } ] "]" .
