/* TDL grammar, EBNF appendix to spec.md.

   Wirth syntax notation, described in notation.ebnf: "..." terminals,
   [ ] optional, { } zero-or-more, | alternation, and a '.' ending each
   production.  golang.org/x/exp/ebnf parses this dialect, which is what
   internal/ebnf reads it with.

   Doc comments ('///' to end of line) are lexical.  They attach to the
   declaration, field, or variant that follows and are omitted below.

   `reserved_word` is a word the lexer reserves, the set lex.Keywords
   returns.  It is narrower than the words this grammar quotes: `key`,
   `owned`, and `deprecated` are contextual and lex as `identifier`,
   so they are already legal names and Name is not what admits them.
   It and the other lexical names are declared at the end.

   Whitespace is insignificant and there are no separator rules: an item
   ends where the next begins.  Commas appear only where written below,
   inside '<...>', conformance lists, and list literals, and are required
   there.  They are not permitted inside '{ }' blocks. */

/* Annotations open `/*@` and are read by internal/ebnf; see
   design/treesitter.md.  A reader who ignores them loses nothing, and
   each one states something the prose below already explains.

   The file-level ones come first. */

/*@ word identifier */
/*@ extra doc_comment line_comment */
/*@ token doc_comment = DocPattern */
/*@ token line_comment = LineCommentPattern */

/*@ conflict Field KeyRequirement */
/*@ conflict UnitExpr TypeRef */
/*@ conflict Path Directive */

File     = { [ Deprecated ] Decl } .
/*@ hidden */
Decl     = PackageDecl | ImportDecl | PrimitiveDecl | UnitDecl
         | AliasDecl | TypeDecl | ValueDecl | EntityDecl | EnumDecl
         | ClassDecl | MixinDecl | InstanceDecl | TargetDecl .

PackageDecl = "package" DottedIdent .
ImportDecl  = "import" string_lit "as" ( identifier | "_" ) .
DottedIdent = identifier { "." identifier } .

Name = identifier | reserved_word .
/* A name may be spelled with a reserved word only where what surrounds it
   says which reading is meant.  A field name is followed by ':', so
   `include Foo` is an include and `include: Foo` is a field.  A directive
   name and a target path segment need no such test, because that
   namespace belongs to the backend.

   Every other name is a plain identifier, so `value value`, `enum type`,
   `import "x" as type`, and `x: value` are each errors. */

/* ---- roots and units ---------------------------------------------------- */

PrimitiveDecl = "primitive" identifier [ ":" Kind ] .

UnitDecl = "unit" identifier [ "=" UnitExpr ] .
/*@ prec.left 1 */
UnitExpr = UnitTerm { ( "*" | "/" ) UnitTerm } .
UnitTerm = identifier [ "^" int_lit ] | "(" UnitExpr ")" .

/* ---- parameters, kinds, constraints ------------------------------------- */

TypeParams = "<" TypeParam { "," TypeParam } ">" .
TypeParam  = identifier [ ":" Kind ] .
/*@ prec.right 1 */
Kind       = KindAtom { "->" KindAtom } .
KindAtom   = "type" | "unit" | "(" Kind ")" .

RequiresClause = "requires" ClassRef { "," ClassRef } .
ClassRef       = DottedIdent [ TypeArgs ] .

/* ---- declarations ------------------------------------------------------- */

AliasDecl  = "alias" identifier [ TypeParams ] "=" TypeRef .

TypeDecl   = "type" identifier [ TypeParams ] ":" TypeRef
             [ RequiresClause ] [ ConstraintBlock ] .

ValueDecl  = "value"  identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
EntityDecl = "entity" identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
MixinDecl  = "mixin"  identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
EnumDecl   = "enum"   identifier [ TypeParams ] [ Conforms ] [ RequiresClause ]
             "{" { Variant } "}" .

Conforms = ":" ClassRef { "," ClassRef } .

Body    = "{" { Member } "}" .
/*@ hidden */
Member  = Include | Field .
Include = "include" NamedType .

Variant = [ Deprecated ] identifier [ "{" { Field } "}" ] .

Field    = { FieldMod } Name ":" TypeRef { FieldRel }
           [ ConstraintBlock ] [ "=" Literal ] .
/*@ hidden */
FieldMod = "key" | Deprecated .
/*@ inline */
FieldRel = "owned" .

Deprecated = "deprecated" [ "(" string_lit ")" ] .
/* Deprecated may also precede any Decl and any Variant. */

/* ---- classes and instances ---------------------------------------------- */

ClassDecl   = "class" identifier [ TypeParams ] [ FunDeps ] [ Conforms ]
              [ RequiresClause ] "{" { ClassMember } "}" .
/*@ hidden */
ClassMember = Field | KeyRequirement | AssocTypeReq .
KeyRequirement = "key" .
/* A class may not declare key fields, so a Field in a class body carries no
   "key" modifier.  Whitespace is insignificant, so a bare KeyRequirement
   followed by a field would otherwise read as one key field. */
AssocTypeReq   = "type" identifier [ ":" Kind ] .

FunDeps = "|" FunDep { "," FunDep } .
FunDep  = identifier { identifier } "->" identifier { identifier } .

InstanceDecl  = "instance" [ TypeParams ] DottedIdent
                ( TypeArgs | "for" NamedType )
                [ RequiresClause ] [ "{" { AssocTypeBind } "}" ] .
AssocTypeBind = "type" identifier "=" TypeRef .
/* "instance C for T" is sugar for "instance C<T>". */

/* ---- type references ---------------------------------------------------- */

TypeRef   = CoreType [ "?" ] [ "|" "null" ] .
/*@ hidden */
CoreType  = ListType | SetOrMapType | NamedType .
ListType  = "[" TypeRef "]" .
SetOrMapType = "{" TypeRef [ "->" TypeRef ] "}" .
NamedType = DottedIdent [ TypeArgs ] .
/* Collection forms are sugar: [T] is List<T>, {T} is Set<T>,
   {K -> V} is Map<K, V>, T? is Option<T>, T | null is Nullable<T>. */

TypeArgs = "<" TypeArg { "," TypeArg } ">" .
/*@ hidden */
TypeArg  = UnitExpr | TypeRef .
/* A bare identifier may name a type or a unit.  The parser records the
   syntactic form; the resolver picks by kind. */

/* ---- constraints -------------------------------------------------------- */

ConstraintBlock = "where" "{" { Constraint } "}" .
Constraint      = identifier [ "(" [ ConstraintArg { "," ConstraintArg } ] ")" ] .
/*@ hidden */
ConstraintArg   = Range | regex_lit | Literal .
Range           = [ int_lit ] ".." [ int_lit ] .
/* Arguments are parenthesized, as for a directive, and for the same
   reason: the constraint set is open, so the parser does not know any
   name's arity and `min 0 max 100` would otherwise be ambiguous.

   The standard set is min, max, length, matches, oneOf, and unique.  The
   compiler checks their arity and argument kinds and passes every other
   name through untouched. */

/* ---- targets ------------------------------------------------------------ */

TargetDecl  = "target" identifier "for" DottedIdent "{" { TargetEntry } "}" .
TargetEntry = Path "{" { TargetEntry } "}"
            | Path "=>" Directive
            | Directive .
Directive   = Name [ "(" [ DirectiveArg { "," DirectiveArg } ] ")" ] .
/*@ hidden */
DirectiveArg = Literal .
Path        = Name { "." Name } .
/* Arguments are parenthesized.  Without a delimiter, `table snake_case`
   followed by another entry cannot be told from `table` applied to three
   arguments, since whitespace is insignificant. */

/* ---- literals ----------------------------------------------------------- */

/*@ hidden */
Literal     = string_lit | int_lit | float_lit | bool_lit | ListLiteral
            | DottedIdent .
ListLiteral = "[" [ Literal { "," Literal } ] "]" .
/* A DottedIdent literal names an enum variant, as in `status: Status =
   Draft`.  The parser records the name; the resolver checks it against the
   field's type. */

/* ---- lexical productions ------------------------------------------------ */

/* The lexer's, not the grammar's.  A production with no expression names
   something defined elsewhere, which is how this notation says so, and
   the `token` annotation says which lex symbol defines it. */

/*@ token IdentPattern */
identifier = .
/*@ token StringPattern */
string_lit = .
/*@ token IntPattern */
int_lit    = .
/*@ token FloatPattern */
float_lit  = .

/* `/` opens a regex and divides a unit expression, and no token-local
   rule separates them.  The reference lexer scans a regex only when the
   parser asks, via RescanRegexAt; tree-sitter needs an external scanner
   for the same reason. */
/*@ token RegexPattern */
/*@ external */
regex_lit = .

/* Spelled out rather than annotated: these are keywords, and the lexer
   already produces each one.  internal/ebnf checks reserved_word against
   lex.Keywords, so a keyword added there and not here is an error. */

bool_lit = "true" | "false" .

reserved_word = "package" | "import" | "as" | "primitive" | "unit"
              | "alias" | "type" | "value" | "entity" | "enum" | "class"
              | "mixin" | "instance" | "target" | "for" | "requires"
              | "where" | "include" | "null" | "true" | "false" | "union" .
