(* TDL grammar, EBNF appendix to spec.md.
   Notation: '...' terminals, [ ] optional, { } zero-or-more, | alternation.

   Doc comments ('///' to end of line) are lexical.  They attach to the
   declaration, field, or variant that follows and are omitted below.

   Whitespace is insignificant and there are no separator rules: an item
   ends where the next begins.  Commas appear only where written below,
   inside '<...>', conformance lists, and list literals, and are required
   there.  They are not permitted inside '{ }' blocks. *)

File     = { [ Deprecated ] Decl } .
Decl     = PackageDecl | ImportDecl | PrimitiveDecl | UnitDecl
         | AliasDecl | TypeDecl | ValueDecl | EntityDecl | EnumDecl
         | ClassDecl | MixinDecl | InstanceDecl | TargetDecl .

PackageDecl = "package" DottedIdent .
ImportDecl  = "import" string_lit "as" ( identifier | "_" ) .
DottedIdent = identifier { "." identifier } .

(* ---- roots and units ---------------------------------------------------- *)

PrimitiveDecl = "primitive" identifier [ ":" Kind ] .

UnitDecl = "unit" identifier [ "=" UnitExpr ] .
UnitExpr = UnitTerm { ( "*" | "/" ) UnitTerm } .
UnitTerm = identifier [ "^" int_lit ] | "(" UnitExpr ")" .

(* ---- parameters, kinds, constraints ------------------------------------- *)

TypeParams = "<" TypeParam { "," TypeParam } ">" .
TypeParam  = identifier [ ":" Kind ] .
Kind       = KindAtom { "->" KindAtom } .
KindAtom   = "type" | "unit" | "(" Kind ")" .

RequiresClause = "requires" ClassRef { "," ClassRef } .
ClassRef       = DottedIdent [ TypeArgs ] .

(* ---- declarations ------------------------------------------------------- *)

AliasDecl  = "alias" identifier [ TypeParams ] "=" TypeRef .

TypeDecl   = "type" identifier [ TypeParams ] ":" TypeRef
             [ RequiresClause ] [ ConstraintBlock ] .

ValueDecl  = "value"  identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
EntityDecl = "entity" identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
MixinDecl  = "mixin"  identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
EnumDecl   = "enum"   identifier [ TypeParams ] [ Conforms ] [ RequiresClause ]
             "{" { Variant } "}" .

Conforms = ":" ClassRef { "," ClassRef } .

Body    = "{" { Member } "}" .
Member  = Include | Field .
Include = "include" NamedType .

Variant = [ Deprecated ] identifier [ "{" { Field } "}" ] .

Field    = { FieldMod } identifier ":" TypeRef { FieldRel }
           [ ConstraintBlock ] [ "=" Literal ] .
FieldMod = "key" | Deprecated .
FieldRel = "owned" .

Deprecated = "deprecated" [ "(" string_lit ")" ] .
(* Deprecated may also precede any Decl and any Variant. *)

(* ---- classes and instances ---------------------------------------------- *)

ClassDecl   = "class" identifier [ TypeParams ] [ FunDeps ] [ Conforms ]
              [ RequiresClause ] "{" { ClassMember } "}" .
ClassMember = Field | KeyRequirement | AssocTypeReq .
KeyRequirement = "key" .
AssocTypeReq   = "type" identifier [ ":" Kind ] .

FunDeps = "|" FunDep { "," FunDep } .
FunDep  = identifier { identifier } "->" identifier { identifier } .

InstanceDecl  = "instance" [ TypeParams ] DottedIdent
                ( TypeArgs | "for" NamedType )
                [ RequiresClause ] [ "{" { AssocTypeBind } "}" ] .
AssocTypeBind = "type" identifier "=" TypeRef .
(* "instance C for T" is sugar for "instance C<T>". *)

(* ---- type references ---------------------------------------------------- *)

TypeRef   = CoreType [ "?" ] [ "|" "null" ] .
CoreType  = ListType | SetOrMapType | NamedType .
ListType  = "[" TypeRef "]" .
SetOrMapType = "{" TypeRef [ "->" TypeRef ] "}" .
NamedType = DottedIdent [ TypeArgs ] .
(* Collection forms are sugar: [T] is List<T>, {T} is Set<T>,
   {K -> V} is Map<K, V>, T? is Option<T>, T | null is Nullable<T>. *)

TypeArgs = "<" TypeArg { "," TypeArg } ">" .
TypeArg  = UnitExpr | TypeRef .
(* A bare identifier may name a type or a unit.  The parser records the
   syntactic form; the resolver picks by kind. *)

(* ---- constraints -------------------------------------------------------- *)

ConstraintBlock = "where" "{" { Constraint } "}" .
Constraint = "min" Literal
           | "max" Literal
           | "length" Range
           | "matches" regex_lit
           | "oneOf" ListLiteral
           | "unique" .
Range = [ int_lit ] ".." [ int_lit ] | int_lit .

(* ---- targets ------------------------------------------------------------ *)

TargetDecl  = "target" identifier "for" DottedIdent "{" { TargetEntry } "}" .
TargetEntry = Path "{" { TargetEntry } "}"
            | Path "=>" Directive
            | Directive .
Directive   = identifier { DirectiveArg } .
DirectiveArg = Literal | Path .
Path        = identifier { "." identifier } .

(* ---- literals ----------------------------------------------------------- *)

Literal     = string_lit | int_lit | float_lit | bool_lit | ListLiteral .
ListLiteral = "[" [ Literal { "," Literal } ] "]" .
