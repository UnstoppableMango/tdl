/* TDL grammar, EBNF appendix to spec.md, in the Wirth syntax notation
   described in notation.ebnf.

   Doc comments ('///' to end of line) are lexical.  They attach to the
   declaration, field, or variant that follows and are omitted below.

   `reserved_word` is the set lex.Keywords returns.  `owned` and
   `deprecated` are contextual and lex as `identifier`, so Name is not
   what admits them.  The lexical names are declared at the end.

   Whitespace is insignificant and there are no separator rules: an item
   ends where the next begins.  Commas appear only where written below
   and are required there. */

/* `/*@` annotations describe this grammar to the tree-sitter generator;
   design/treesitter.md defines them.  A reader may ignore them. */

/*@ word identifier */
/*@ extra doc_comment line_comment */
/*@ token doc_comment = DocPattern */
/*@ token line_comment = LineCommentPattern */

/*@ conflict ClassRef NamedType */
/*@ conflict DottedIdent UnitTerm */
/*@ conflict Field */

File     = { [ Deprecated ] Decl } .
/*@ hidden */
Decl     = PackageDecl | ImportDecl | PrimitiveDecl | UnitDecl
         | AliasDecl | TypeDecl | EnumDecl
         | ClassDecl | MixinDecl | InstanceDecl | TargetDecl .

PackageDecl = "package" Name { "." Name } .
ImportDecl  = "import" string_lit "as" ( identifier | "_" ) .
DottedIdent = identifier { "." identifier } .

Name = identifier | reserved_word .
/* A name may be a reserved word only where its surroundings settle the
   reading: a field name before ':' (`include: Foo` is a field), a
   directive name, a target path segment, and a package path segment
   after `package` or a target's `for`, as in `package google.type`.

   Every other name is a plain identifier, so `enum type`,
   `import "x" as type`, and `x: mixin` are each errors. */

/* ---- roots and units ---------------------------------------------------- */

PrimitiveDecl = "primitive" identifier [ ":" Kind ] .

UnitDecl = "unit" identifier [ "=" UnitExpr ] .
/*@ prec.left 1 */
UnitExpr = UnitTerm { ( "*" | "/" ) UnitTerm } .
UnitTerm = identifier [ "^" int_lit ] | "(" UnitExpr ")" .

/* ---- parameters, kinds, constraints ------------------------------------- */

TypeParams = "<" TypeParam { "," TypeParam } ">" .
TypeParam  = identifier [ ":" Kind ] .
/*@ prec.right 1 */
Kind       = KindAtom { "->" KindAtom } .
KindAtom   = "type" | "unit" | "(" Kind ")" .

RequiresClause = "requires" ClassRef { "," ClassRef } .
ClassRef       = DottedIdent [ TypeArgs ] .

/* ---- declarations ------------------------------------------------------- */

AliasDecl  = "alias" identifier [ TypeParams ] "=" TypeRef .

TypeDecl   = "type" identifier [ TypeParams ]
             ( ":" TypeRef [ RequiresClause ] [ ConstraintBlock ]
             | [ Conforms ] [ RequiresClause ] Body ) .
/* With a body, the colon list is conformance; without one, the type is
   a newtype and the colon names its base.  A "{" after the colon list or
   the requires clause always opens a body. */

MixinDecl  = "mixin"  identifier [ TypeParams ] [ Conforms ] [ RequiresClause ] Body .
EnumDecl   = "enum"   identifier [ TypeParams ] [ Conforms ] [ RequiresClause ]
             "{" { Variant } "}" .

Conforms = ":" ClassRef { "," ClassRef } .

Body    = "{" { Member } "}" .
/*@ hidden */
Member  = Include | Field .
Include = "include" NamedType .

Variant = [ Deprecated ] identifier [ "{" { Field } "}" ] .

Field    = [ Deprecated ] Name ":" TypeRef { FieldRel }
           [ ConstraintBlock ] [ "=" Literal ] .
/*@ inline */
FieldRel = "owned" .

Deprecated = "deprecated" [ "(" string_lit ")" ] .
/* Deprecated may also precede any Decl and any Variant. */

/* ---- classes and instances ---------------------------------------------- */

ClassDecl   = "class" identifier [ TypeParams ] [ FunDeps ] [ Conforms ]
              [ RequiresClause ] "{" { ClassMember } "}" .
/*@ hidden */
ClassMember  = Field | AssocTypeReq .
AssocTypeReq = "type" identifier [ ":" Kind ] .

FunDeps = "|" FunDep { "," FunDep } .
FunDep  = identifier { identifier } "->" identifier { identifier } .

InstanceDecl  = "instance" [ TypeParams ] DottedIdent
                ( TypeArgs | "for" NamedType )
                [ RequiresClause ] [ "{" { AssocTypeBind } "}" ] .
AssocTypeBind = "type" identifier "=" TypeRef .
/* "instance C for T" is sugar for "instance C<T>". */

/* ---- type references ---------------------------------------------------- */

TypeRef   = CoreType [ "?" ] [ "|" "null" ] .
/*@ hidden */
CoreType  = ListType | SetOrMapType | NamedType .
ListType  = "[" TypeRef "]" .
SetOrMapType = "{" TypeRef [ "->" TypeRef ] "}" .
NamedType = DottedIdent [ TypeArgs ] .
/* Collection forms are sugar: [T] is List<T>, {T} is Set<T>,
   {K -> V} is Map<K, V>, T? is Option<T>, T | null is Nullable<T>. */

TypeArgs = "<" TypeArg { "," TypeArg } ">" .
/*@ hidden */
TypeArg  = UnitExpr | TypeRef .
/* A bare identifier may name a type or a unit.  The parser records the
   syntactic form; the resolver picks by kind. */

/* ---- constraints -------------------------------------------------------- */

ConstraintBlock = "where" "{" { Constraint } "}" .
Constraint      = identifier [ "(" [ ConstraintArg { "," ConstraintArg } ] ")" ] .
/*@ hidden */
ConstraintArg   = Range | regex_lit | Literal .
Range           = [ int_lit ] ".." [ int_lit ] .
/* Arguments are parenthesized because the constraint set is open: the
   parser knows no name's arity, and `min 0 max 100` would be ambiguous.

   The compiler checks the arity and argument kinds of min, max, length,
   matches, oneOf, and unique, and passes every other name through
   untouched. */

/* ---- targets ------------------------------------------------------------ */

TargetDecl  = "target" identifier "for" Name { "." Name } "{" { TargetEntry } "}" .
TargetEntry = Path "{" { TargetEntry } "}"
            | Path "=>" Directive
            | Directive .
Directive   = Name [ "(" [ DirectiveArg { "," DirectiveArg } ] ")" ] .
/*@ hidden */
DirectiveArg = Literal .
Path        = Name { "." Name } .
/* Without parentheses, `table snake_case` followed by another entry
   could not be told from `table` applied to three arguments. */

/* ---- literals ----------------------------------------------------------- */

/*@ hidden */
Literal     = string_lit | int_lit | float_lit | bool_lit | ListLiteral
            | DottedIdent .
ListLiteral = "[" [ Literal { "," Literal } ] "]" .
/* A DottedIdent literal names an enum variant, as in `status: Status =
   Draft`; the resolver checks it against the field's type. */

/* ---- lexical productions ------------------------------------------------ */

/* A production with no expression is defined by the lexer; its `token`
   annotation names the lex symbol. */

/*@ token IdentPattern */
identifier = .
/*@ token StringPattern */
string_lit = .
/*@ token IntPattern */
int_lit    = .
/*@ token FloatPattern */
float_lit  = .

/* `/` both opens a regex and divides a unit expression, so the lexer
   scans a regex only when the parser asks (lex.RescanRegexAt), and
   tree-sitter uses an external scanner. */
/*@ token RegexPattern */
/*@ external */
regex_lit = .

/* Spelled out rather than annotated.  internal/ebnf checks reserved_word
   against lex.Keywords, so a keyword added there and not here is an
   error. */

bool_lit = "true" | "false" .

reserved_word = "package" | "import" | "as" | "primitive" | "unit"
              | "alias" | "type" | "enum" | "class" | "mixin"
              | "instance" | "target" | "for" | "requires" | "where"
              | "include" | "null" | "true" | "false" .
