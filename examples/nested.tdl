// The same domain as flat.tdl, split into declarations. Parallel lists
// become a list of a value, and the address group becomes one optional
// field instead of five.
//
// Conforming to Entity is the modelling decision: an Order has identity
// that survives its contents changing, an Address does not.
package shop.nested

type Order: Entity {
  id: string
  customer: Customer
  shipping: Address?
  items: [LineItem] owned where { length(1..) }
  status: Status = Draft
  total: Money
}

type Customer: Entity {
  email: string where { matches(/^[^@]+@[^@]+$/) }
  name: string?
}

type Address {
  line1: string
  line2: string?
  city: string
  postcode: string
  country: string
}

type LineItem {
  sku: string
  quantity: int where { min(1) } = 1
}

type Money {
  amount: decimal
  currency: Currency
}

enum Currency { USD EUR GBP }
enum Status { Draft Placed Shipped Cancelled }
