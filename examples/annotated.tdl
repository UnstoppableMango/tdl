// nested.tdl with backend mapping attached. The shape is unchanged; the
// annotations say how each backend should render it. Nothing in the
// parser interprets these namespaces.
package shop.annotated.v1

@go(pkg: "shop")
@protobuf(message: "Order")
type Order {
  @protobuf(number: 1)
  id: string

  @protobuf(number: 2)
  customer: Customer

  @go(tag: "json:\"shipping,omitempty\"")
  @protobuf(number: 3)
  shipping: Address?

  @protobuf(number: 4)
  items: list<LineItem>

  @protobuf(number: 5)
  status: Status = "draft"
}

type Customer {
  @protobuf(number: 1)
  email: string

  @protobuf(number: 2)
  name: string?
}

type Address {
  line1: string
  line2: string?
  city: string
  postcode: string
  country: string
}

type LineItem {
  sku: string
  quantity: int32 = 1
}

// `enum:` would be a syntax error here: keywords are rejected as
// annotation argument names in M1.
@protobuf(name: "OrderStatus")
enum Status {
  @protobuf(number: 0)
  draft

  @protobuf(number: 1)
  placed

  @protobuf(number: 2)
  shipped
}
