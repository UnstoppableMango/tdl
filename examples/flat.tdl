// One record, everything inline. Optionality carries the modelling:
// a shipped order and a draft order are the same type, distinguished by
// which fields happen to be set.
package shop.flat.v1

type Order {
  id: string
  customer_email: string
  customer_name: string?

  ship_line1: string?
  ship_line2: string?
  ship_city: string?
  ship_postcode: string?
  ship_country: string?

  item_skus: list<string>
  item_quantities: list<int32>

  status: string = "draft"
  total_cents: int64 = 0
}
