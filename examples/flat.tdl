// One entity, everything inline. Optionality carries the modelling:
// a shipped order and a draft order are the same type, distinguished by
// which fields happen to be set.
package shop.flat

entity Order {
  key id: string
  customerEmail: string
  customerName: string?
  shipLine1: string?
  shipLine2: string?
  shipCity: string?
  shipPostcode: string?
  shipCountry: string?
  itemSkus: [string]
  itemQuantities: [int]
  status: string = "draft"
  totalCents: int = 0
}
