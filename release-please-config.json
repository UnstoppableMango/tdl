{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": true,
	"packages": {
		".": {
			"release-type": "simple",
			"package-name": "tdl",
			"include-component-in-tag": false,
			"extra-files": [
				"internal/cli/version.go",
				"flake.nix",
				"README.md",
				"dotnet/Tdl.Gen.CSharp/Tdl.Gen.CSharp.csproj",
				{
					"type": "json",
					"path": "editors/vscode/package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "editors/vscode/package-lock.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "editors/vscode/package-lock.json",
					"jsonpath": "$.packages[''].version"
				},
				{
					"type": "json",
					"path": "npm/tdl/package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "npm/tdl-typescript/package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "js/remark-tdl-mermaid/package.json",
					"jsonpath": "$.version"
				},
				{
					"type": "json",
					"path": "js/package-lock.json",
					"jsonpath": "$.packages['remark-tdl-mermaid'].version"
				}
			],
			"changelog-sections": [
				{
					"type": "feat",
					"section": "Features"
				},
				{
					"type": "fix",
					"section": "Bug Fixes"
				},
				{
					"type": "perf",
					"section": "Performance Improvements"
				},
				{
					"type": "revert",
					"section": "Reverts"
				},
				{
					"type": "docs",
					"section": "Documentation"
				},
				{
					"type": "refactor",
					"section": "Code Refactoring"
				},
				{
					"type": "test",
					"section": "Tests"
				},
				{
					"type": "build",
					"section": "Build System"
				},
				{
					"type": "deps",
					"section": "Dependencies"
				},
				{
					"type": "ci",
					"section": "Continuous Integration"
				},
				{
					"type": "chore",
					"section": "Miscellaneous Chores",
					"hidden": true
				}
			]
		}
	}
}
