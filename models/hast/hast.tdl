// hast, the hypertext abstract syntax tree, as rehype produces it.
// https://github.com/syntax-tree/hast
//
// Every node is a variant of Nodes, tagged by `type` as on the wire.
// A root or an element holds comments, elements, and text, and only a root
// holds a doctype. TDL has no way to name a subset of an enum's variants
// yet, so children are Nodes.
//
// A property value in hast is a boolean, a number, a string, null, or a
// list of strings and numbers. TDL has no untagged union yet (see
// docs/backlog.md, "Anonymous union types"), so PropertyValue narrows it to
// a string.
//
// Point, Position, and Data repeat unist.tdl, since the go and typescript
// backends do not generate a type from another package yet.
/// The hypertext abstract syntax tree.
package hast

/// One place in a source file.
type Point {
  /// The 1-indexed line.
  line: int where { min(1) }
  /// The 1-indexed column.
  column: int where { min(1) }
  /// The 0-indexed offset into the file.
  offset: int? where { min(0) }
}

/// The span of a node in its source file. A generated node has none.
type Position {
  /// The place of the first character of the node.
  start: Point
  /// The place after the last character of the node.
  end: Point
}

/// Information from the ecosystem. It is empty here, and a plugin
/// extends it.
type Data { }

/// The value of one property of an element, narrowed to a string.
type PropertyValue: string

/// Every hast node.
enum Nodes {
  /// A whole document or a fragment.
  root {
    /// Comments, a doctype, elements, and text.
    children: [Nodes]
    /// Information from the ecosystem.
    data: Data?
    /// Where the node came from. Absent when it was generated.
    position: Position?
  }
  /// An element, such as a `<p>`.
  element {
    /// The local name of the element, such as `p`.
    tagName: string
    /// The element's properties, keyed by their camel-cased DOM names.
    properties: {string -> PropertyValue}
    /// Comments, elements, and text.
    children: [Nodes]
    /// The content of a `<template>`, always a root.
    content: Nodes?
    /// Information from the ecosystem.
    data: Data?
    /// Where the node came from. Absent when it was generated.
    position: Position?
  }
  /// Everything that is just text.
  text {
    /// The text of the node.
    value: string
    /// Information from the ecosystem.
    data: Data?
    /// Where the node came from. Absent when it was generated.
    position: Position?
  }
  /// An HTML comment.
  comment {
    /// The text of the comment.
    value: string
    /// Information from the ecosystem.
    data: Data?
    /// Where the node came from. Absent when it was generated.
    position: Position?
  }
  /// A document type declaration, `<!doctype html>`.
  doctype {
    /// Information from the ecosystem.
    data: Data?
    /// Where the node came from. Absent when it was generated.
    position: Position?
  }
}

target go for hast {
  out(".")
  package("github.com/unstoppablemango/tdl/models/hast")
  Nodes.root => name("Root")
  Nodes.element => name("Element")
  Nodes.text => name("Text")
  Nodes.comment => name("Comment")
  Nodes.doctype => name("Doctype")
}

target typescript for hast {
  out("ts")
  discriminant("type")
  Nodes.root => name("Root")
  Nodes.element => name("Element")
  Nodes.text => name("Text")
  Nodes.comment => name("Comment")
  Nodes.doctype => name("Doctype")
}
