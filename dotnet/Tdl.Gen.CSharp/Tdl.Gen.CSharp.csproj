<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>tdl-gen-csharp</AssemblyName>
		<RootNamespace>Tdl.Gen.CSharp</RootNamespace>
		<Description>The csharp target: C# source from a TDL model, built with Roslyn.</Description>
		<!-- One native binary with no runtime to start, so each tdl gen
		     pays no JIT for Roslyn. -->
		<PublishAot>true</PublishAot>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Tdl.Plugin/Tdl.Plugin.csproj" />
		<ProjectReference Include="../Tdl.DotNet/Tdl.DotNet.csproj" />
	</ItemGroup>
</Project>
