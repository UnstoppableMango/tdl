		"tdl-gen-js_debug": "dist/src/main.js"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.17.0",
		"@unmango/tdl-plugin": "0.1.0"
	}
}
