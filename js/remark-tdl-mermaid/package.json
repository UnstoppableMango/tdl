{
	"name": "@unmango/remark-tdl-mermaid",
	"version": "0.5.11",
	"description": "A remark plugin that draws each tdl mermaid code fence as a Mermaid class diagram, through the Type Description Language compiler",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/UnstoppableMango/tdl.git",
		"directory": "js/remark-tdl-mermaid"
	},
	"homepage": "https://github.com/UnstoppableMango/tdl/blob/main/js/remark-tdl-mermaid/README.md",
	"keywords": [
		"remark",
		"remark-plugin",
		"mermaid",
		"tdl",
		"unified"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		}
	},
	"files": [
		"dist/src"
	],
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"@types/mdast": "^4.0.4",
		"remark": "^15.0.1",
		"vfile": "^6.0.3"
	},
	"peerDependencies": {
		"@types/mdast": "^4.0.4",
		"vfile": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"@types/mdast": {
			"optional": true
		},
		"vfile": {
			"optional": true
		}
	}
}
