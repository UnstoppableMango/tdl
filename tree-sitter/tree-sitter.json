{
	"$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
	"grammars": [
		{
			"name": "tdl",
			"camelcase": "TDL",
			"scope": "source.tdl",
			"path": ".",
			"file-types": [
				"tdl"
			],
			"injection-regex": "^tdl$"
		}
	],
	"metadata": {
		"version": "0.1.3",
		"license": "GPL-3.0-or-later",
		"description": "TDL grammar for tree-sitter, derived from docs/grammar.ebnf",
		"authors": [
			{
				"name": "Erik Rasmussen",
				"email": "erik.rasmussen@unmango.dev"
			}
		],
		"links": {
			"repository": "https://github.com/UnstoppableMango/tdl"
		}
	},
	"bindings": {
		"c": false,
		"go": false,
		"node": false,
		"python": false,
		"rust": false,
		"swift": false,
		"kotlin": false,
		"zig": false
	}
}
