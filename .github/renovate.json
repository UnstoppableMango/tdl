{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"github>UnstoppableMango/renovate-config",
		"github>UnstoppableMango/renovate-config:release-please",
		"github>UnstoppableMango/renovate-config:gomod2nix(nix)",
		"github>UnstoppableMango/renovate-config:nuget2nix(./tools/nugetdeps)",
		"schedule:monthly"
	],
	"constraints": {
		"dotnet": "10.0.404"
	},
	"automerge": true,
	"packageRules": [
		{
			"description": "The generated code in rust/tdl-plugin/src/generated targets one buffa release: bump it with nix/protoc-gen-buffa.nix and make generate, by hand.",
			"matchManagers": [
				"cargo"
			],
			"matchPackageNames": [
				"buffa"
			],
			"enabled": false
		},
		{
			"description": "The generated code in js/tdl-plugin/src/generated targets one protobuf-es release: bump the runtime and the plugin together in js/ and run make generate, by hand.",
			"matchManagers": [
				"npm"
			],
			"matchPackageNames": [
				"@bufbuild/protobuf",
				"@bufbuild/protoc-gen-es"
			],
			"enabled": false
		},
		{
			"groupName": "tdl",
			"matchPackageNames": [
				"/unstoppablemango/tdl/"
			]
		}
	]
}
